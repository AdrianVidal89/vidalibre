# Copia este fichero a .env y ajusta lo que haga falta.

# La biblioteca de Calibre que ya existe en el NAS (la carpeta con metadata.db
# dentro). Es la MISMA que usa Calibre-Web: Vidalibre no copia nada.
BIBLIOTECA=/share/Calibre/books

# Puerto en el que se abre. El 8083 es el de Calibre-Web: mientras convivan,
# aquí va otro.
PUERTO=8084

# Usuario con el que corre el contenedor. En el NAS, adrian es 1000 y su grupo
# es `everyone` (100).
USUARIO=1000:100

# Nombre que sale en la cabecera.
TITULO=Vidalibre

# Ponlo a 1 para que no se pueda escribir nada (ni subir, ni editar, ni borrar).
SOLO_LECTURA=0

TZ=Europe/Madrid
CALIBRE_VERSION=9.14.0
